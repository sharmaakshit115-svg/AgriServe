CREATE DATABASE AgriServeDB;
USE AgriServeDB;
 
CREATE TABLE User (
    UserID INT AUTO_INCREMENT PRIMARY KEY,
    Name VARCHAR(150) NOT NULL,
    Role ENUM('Farmer','Officer','Manager','Admin','Compliance','Auditor') NOT NULL,
    Email VARCHAR(150) UNIQUE NOT NULL,
    Phone VARCHAR(20),
    Status ENUM('Active','Inactive') DEFAULT 'Active'
);
 
CREATE TABLE AuditLog (
    AuditID INT AUTO_INCREMENT PRIMARY KEY,
    UserID INT,
    Action VARCHAR(255),
    Resource VARCHAR(255),
    Timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (UserID) REFERENCES User(UserID)
);
 
CREATE TABLE Farmer (
    FarmerID INT AUTO_INCREMENT PRIMARY KEY,
    Name VARCHAR(150),
    DOB DATE,
    Gender ENUM('Male','Female','Other'),
    Address TEXT,
    ContactInfo VARCHAR(100),
    LandSize DECIMAL(10,2),
    CropType VARCHAR(100),
    Status ENUM('Active','Inactive') DEFAULT 'Active'
);
 
CREATE TABLE FarmerDocument (
    DocumentID INT AUTO_INCREMENT PRIMARY KEY,
    FarmerID INT NOT NULL,
    DocType ENUM('IDProof','LandRecord') NOT NULL,
    FileURI VARCHAR(255),
    UploadedDate DATE,
    VerificationStatus ENUM('Pending','Approved','Rejected') DEFAULT 'Pending',
    FOREIGN KEY (FarmerID) REFERENCES Farmer(FarmerID)
);
 
CREATE TABLE AdvisoryContent (
    ContentID INT AUTO_INCREMENT PRIMARY KEY,
    Title VARCHAR(200),
    Description TEXT,
    FileURI VARCHAR(255),
    Category ENUM('Crop','Soil','Market'),
    UploadedDate DATE,
    Status ENUM('Active','Inactive') DEFAULT 'Active'
);
 
CREATE TABLE AdvisorySession (
    SessionID INT AUTO_INCREMENT PRIMARY KEY,
    OfficerID INT NOT NULL,
    FarmerID INT NOT NULL,
    ContentID INT NOT NULL,
    Date DATE,
    Feedback TEXT,
    Status ENUM('Completed','Pending','Cancelled') DEFAULT 'Pending',
    FOREIGN KEY (OfficerID) REFERENCES User(UserID),
    FOREIGN KEY (FarmerID) REFERENCES Farmer(FarmerID),
    FOREIGN KEY (ContentID) REFERENCES AdvisoryContent(ContentID)
);
 
CREATE TABLE TrainingProgram (
    ProgramID INT AUTO_INCREMENT PRIMARY KEY,
    Title VARCHAR(200),
    Description TEXT,
    StartDate DATE,
    EndDate DATE,
    Status ENUM('Active','Completed','Cancelled') DEFAULT 'Active'
);
 
CREATE TABLE Workshop (
    WorkshopID INT AUTO_INCREMENT PRIMARY KEY,
    ProgramID INT NOT NULL,
    OfficerID INT NOT NULL,
    Location VARCHAR(255),
    Date DATE,
    Status ENUM('Active','Completed','Cancelled') DEFAULT 'Active',
    FOREIGN KEY (ProgramID) REFERENCES TrainingProgram(ProgramID),
    FOREIGN KEY (OfficerID) REFERENCES User(UserID)
);
 
CREATE TABLE Participation (
    ParticipationID INT AUTO_INCREMENT PRIMARY KEY,
    WorkshopID INT NOT NULL,
    FarmerID INT NOT NULL,
    AttendanceStatus ENUM('Present','Absent') DEFAULT 'Absent',
    Feedback TEXT,
    FOREIGN KEY (WorkshopID) REFERENCES Workshop(WorkshopID),
    FOREIGN KEY (FarmerID) REFERENCES Farmer(FarmerID)
);
 
CREATE TABLE Feedback (
    FeedbackID INT AUTO_INCREMENT PRIMARY KEY,
    FarmerID INT NOT NULL,
    SessionID INT NOT NULL,
    Rating INT CHECK (Rating BETWEEN 1 AND 5),
    Comments TEXT,
    Date DATE,
    FOREIGN KEY (FarmerID) REFERENCES Farmer(FarmerID),
    FOREIGN KEY (SessionID) REFERENCES AdvisorySession(SessionID)
);
 
CREATE TABLE SatisfactionMetric (
    MetricID INT AUTO_INCREMENT PRIMARY KEY,
    ProgramID INT NOT NULL,
    Score DECIMAL(5,2),
    Date DATE,
    Status ENUM('Valid','Invalid') DEFAULT 'Valid',
    FOREIGN KEY (ProgramID) REFERENCES TrainingProgram(ProgramID)
);
 
CREATE TABLE ComplianceRecord (
    ComplianceID INT AUTO_INCREMENT PRIMARY KEY,
    EntityID INT NOT NULL,
    Type ENUM('Advisory','Training'),
    Result VARCHAR(255),
    Date DATE,
    Notes TEXT
);
 
CREATE TABLE Audit (
    AuditID INT AUTO_INCREMENT PRIMARY KEY,
    OfficerID INT NOT NULL,
    Scope VARCHAR(255),
    Findings TEXT,
    Date DATE,
    Status ENUM('Open','Closed') DEFAULT 'Open',
    FOREIGN KEY (OfficerID) REFERENCES User(UserID)
);
 
CREATE TABLE Report (
    ReportID INT AUTO_INCREMENT PRIMARY KEY,
    Scope ENUM('Farmer','Program','Feedback'),
    Metrics TEXT,
    GeneratedDate DATE
);
 
CREATE TABLE Notification (
    NotificationID INT AUTO_INCREMENT PRIMARY KEY,
    UserID INT,
    EntityID INT,
    Message TEXT,
    Category ENUM('Advisory','Training','Feedback','Compliance'),
    Status ENUM('Sent','Pending','Failed') DEFAULT 'Pending',
    CreatedDate TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (UserID) REFERENCES User(UserID)
);
